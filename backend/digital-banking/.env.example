# ============================================================
#  Modèle de configuration locale
#  Copiez ce fichier en .env puis renseignez vos identifiants MySQL.
#  Le fichier .env est ignoré par Git : il ne doit jamais être commité.
# ============================================================

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=banque
MYSQL_USER=root
MYSQL_PASSWORD=
